---
import type { PublicProject } from '@/lib/projects';
import { selectPilotProjectContent } from '@/lib/pilot-project-content';
import { getProjectCategoryLabel } from '@/lib/project-categories';
import { defaultLocale } from '@/i18n/locales';
import { clientLocale, localize } from '@/data/localized/locale';
import { projectsCatalan } from '@/data/localized/projects';
import { pagePath } from '@/lib/localized-routes';
const locale = clientLocale(Astro.currentLocale);
const t = localize(locale, projectsCatalan);
import ProjectGallery from '@/components/projects/ProjectGallery.astro';
import MediaPlaceholder from '@/components/ui/MediaPlaceholder.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';

interface Props { project: PublicProject }
const { project } = Astro.props;
const text = selectPilotProjectContent(project, locale);
const title = text.title ?? t('Proyecto sin título en español');
const paragraphs = text.description?.split(/\r?\n(?:[\t ]*\r?\n)+/) ?? [];
const images = project.images ?? [];
const [cover, ...gallery] = images;
// Keep substantial narratives below the image rather than in a tall, narrow rail.
const alongside = Boolean(cover && text.description && text.description.length <= 600
  && paragraphs.length <= 3 && text.description.split(/\r?\n/).length <= 8);
const category = getProjectCategoryLabel(project.category, Astro.currentLocale ?? defaultLocale);
const metadata = [category, project.year].filter(Boolean).join(' · ');
---
<article class="page-width py-10 md:py-16">
  <header class="mb-8 md:mb-10">
    <a class="eyebrow inline-flex min-h-11 items-center text-muted" href={pagePath('projects', locale)}>← {t('Volver a proyectos')}</a>
    <h1 class="section-heading mt-4 break-words">{title}</h1>
    {metadata && <p class="mt-3 text-lg text-muted">{metadata}</p>}
  </header>
  <div class:list={['grid items-start gap-8 md:gap-12', alongside && 'lg:grid-cols-3']}
    data-description-layout={alongside ? 'alongside' : 'below'}>
    <div class:list={['min-w-0', alongside && 'lg:col-span-2']}>
      {cover ? <figure aria-label={t('Imagen principal')}>
        <img src={cover.url} alt={`${title} — ${t('imagen')} 1 de ${images.length}`}
          loading="eager" fetchpriority="high" decoding="async"
          class:list={['w-full bg-surface object-contain', alongside ? 'aspect-square' : 'aspect-3/2']} />
      </figure> : <MediaPlaceholder label={title} />}
    </div>
    {(paragraphs.length > 0 || text.source === 'missing') &&
      <div class:list={['min-w-0 border-t border-line pt-6',
        alongside ? 'lg:mt-0' : 'max-w-3xl md:ml-0']}>
        {paragraphs.length > 0 && <div class="space-y-6 text-lg leading-relaxed break-words">
          {paragraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
        </div>}
        {text.source === 'missing' && <p class="text-muted">{t('Contenido en español pendiente.')}</p>}
      </div>}
  </div>
  {gallery.length > 0 && <div class="mt-12 md:mt-16">
    <ProjectGallery images={gallery} title={title} startIndex={1} total={images.length} />
  </div>}
  <div class="mt-12 border-t border-line pt-6">
    <ArrowLink href={pagePath('contact', locale)} label={t('Hablemos de tu proyecto')} />
  </div>
</article>
