---
import ContactIcon from '@/components/contact/ContactIcon.astro';
import { localize } from '@/data/localized/locale';
import { contactCatalan } from '@/data/localized/contact';
import { studioContact } from '@/config/contact';
const t = localize(Astro.currentLocale, contactCatalan);
const link = 'inline-flex min-h-11 items-center break-all hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink';
---
<section aria-labelledby="contact-location-title">
  <p class="eyebrow title-rule mb-6">{t('Ven a vernos')}</p>
  <h2 id="contact-location-title" class="section-heading mb-8 max-w-md font-serif">{t('Justo encima de El Melindró.')}</h2>
  <p class="mb-10 max-w-md text-base leading-relaxed text-muted">
    {t('Nuestro estudio se encuentra en la primera planta de la Casa Antoni Clavell Bot, en el corazón de Cardedeu, justo encima de El Melindró.')}
  </p>
  <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,12rem)]">
    <address class="not-italic">
      <ul class="grid gap-3 text-base leading-relaxed">
        <li class="flex items-start gap-4"><ContactIcon name="pin" class="mt-0.5" /><span>{studioContact.street}<br />{studioContact.locality}</span></li>
        <li class="flex items-center gap-4"><ContactIcon name="phone" /><a class={link} href={studioContact.phoneHref}>{studioContact.phoneLabel}</a></li>
        <li class="flex items-center gap-4"><ContactIcon name="mail" /><a class={link} href={`mailto:${studioContact.email}`}>{studioContact.email}</a></li>
        <li class="flex items-center gap-4"><ContactIcon name="instagram" /><a class={link} href={studioContact.instagramUrl}>{studioContact.instagramHandle}</a></li>
      </ul>
    </address>
    <div class="contact-hours flex items-start gap-4 text-sm leading-relaxed">
      <ContactIcon name="clock" class="mt-0.5" />
      <div>
        <h3 class="text-base text-ink">{t('Horario')}</h3>
        <p class="mt-1 text-muted">{t('De lunes a viernes')}<br /><span class="whitespace-nowrap">9:00–18:00</span></p>
        <p class="mt-1 text-muted">{t('Con cita previa.')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .contact-hours { border-left: 1px solid var(--color-line); padding-left: 2rem; }
  }
</style>
