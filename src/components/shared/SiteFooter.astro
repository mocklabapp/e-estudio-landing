---
import BrandMark from '@/components/ui/BrandMark.astro';
import { studioContact } from '@/config/contact';
import { navigationFor } from '@/data/navigation';
import { clientLocale, localize } from '@/data/localized/locale';
import { shellCatalan } from '@/data/localized/shell';
import { pagePath } from '@/lib/localized-routes';
const locale = clientLocale(Astro.currentLocale);
const navigation = navigationFor(locale);
const t = localize(locale, shellCatalan);
const link = 'inline-flex min-h-11 items-center hover:text-brand';
---
<footer class="border-t border-line bg-canvas py-12">
  <div class="page-width grid gap-10 md:grid-cols-4">
    <div><a href={pagePath('home', locale)} aria-label={t('e estudio — Inicio')}><BrandMark compact /></a><p class="mt-8 text-xs text-muted">© e estudio {new Date().getFullYear()}</p></div>
    <nav aria-label={t('Navegación del pie')}><ul class="space-y-2 text-sm">{navigation.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul></nav>
    <address class="text-sm not-italic text-muted">
      <p>{studioContact.street}<br />{studioContact.locality}</p>
      <ul class="mt-4">
        <li><a class={link} href={studioContact.phoneHref}>{studioContact.phoneLabel}</a></li>
        <li><a class:list={[link, 'break-all']} href={`mailto:${studioContact.email}`}>{studioContact.email}</a></li>
        <li><a class={link} href={studioContact.instagramUrl}>Instagram · {studioContact.instagramHandle}</a></li>
      </ul>
    </address>
    <div class="text-sm text-muted"><p>{t('Vista previa de cliente.')}</p><p class="mt-2 text-xs">{t('Tipografía y algunas imágenes provisionales.')}<br />{t('Los formularios no envían información.')}</p></div>
  </div>
</footer>
