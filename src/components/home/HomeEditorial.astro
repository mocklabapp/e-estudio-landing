---
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { clientLocale, localize } from '@/data/localized/locale';
import { homeCatalan } from '@/data/localized/home';
import { pagePath } from '@/lib/localized-routes';
const locale = clientLocale(Astro.currentLocale);
const t = localize(locale, homeCatalan);
---
<section class="page-width grid gap-12 pb-10 md:grid-cols-2 md:gap-14"
  aria-label={t('Arquitectura e investigación')}>
  <div class="min-w-0">
    <img src="/home/architecture.png" width="436" height="282"
      alt={t('Patio abierto al jardín, con un olivo junto al porche')}
      loading="eager" decoding="async" class="h-auto w-full bg-surface" />
    <p class="eyebrow mt-6 text-muted">{t('Nuestra arquitectura')}</p>
    <h2 class="mt-4 text-3xl font-light leading-tight md:text-4xl">
      {t('Proyectamos espacios para ser habitados.')}
    </h2>
    <div class="mt-4"><ArrowLink href={pagePath('services', locale)} label={t('Ver servicios')} /></div>
  </div>
  <div class="min-w-0">
    <img src="/home/living-research.png" width="437" height="282"
      alt={t('Libros junto a una ventana abierta al paisaje arbolado')}
      loading="lazy" decoding="async" class="h-auto w-full bg-surface" />
    <p class="eyebrow mt-6 text-muted">Living Research</p>
    <h2 class="mt-4 text-3xl font-light leading-tight md:text-4xl">
      {t('Investigamos nuevas formas de habitar.')}
    </h2>
    <div class="mt-4"><ArrowLink href={pagePath('research', locale)} label={t('Descubrir Living Research')} /></div>
  </div>
</section>
