---
import ContactBand from '@/components/sections/ContactBand.astro';
import { clientLocale, localize } from '@/data/localized/locale';
import { homeCatalan } from '@/data/localized/home';
const t = localize(clientLocale(Astro.currentLocale), homeCatalan);
---
<ContactBand
  eyebrow={t('Empezamos a hablar')}
  title={`${t('Habitar empieza')}\n${t('con una')}`}
  accent={t('conversación.')}
  accentPosition="end"
/>
